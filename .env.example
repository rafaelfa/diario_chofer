# Diario do Motorista - variaveis locais
# Copie para .env.local e substitua pelos valores do seu ambiente.

# PostgreSQL (Neon). Use a connection string da branch correta.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Gere com: openssl rand -base64 32
JWT_SECRET="REPLACE_WITH_A_RANDOM_SECRET"

# URL publica do ambiente (se aplicavel)
NEXT_PUBLIC_APP_URL="https://your-project.vercel.app"
