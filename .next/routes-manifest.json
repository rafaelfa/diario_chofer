      "regex": "^/api/matricula/lastkm(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/matricula/lastkm(?:/)?$"
    },
    {
      "page": "/api/reports",
      "regex": "^/api/reports(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/reports(?:/)?$"
    },
    {
      "page": "/api/reports/matricula",
